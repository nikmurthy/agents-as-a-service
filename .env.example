# DEVELOPMENT ONLY. Copy to .env for local work against a development database.
# Never put production values in this file: production secrets live in Bitwarden Secrets Manager
# (see "Secrets and security" in the README) and are injected with `npm run prod:...`.
# The same variable names are used as the secret names in Bitwarden.

# A local Postgres or a separate development Supabase project (never the production one).
# For Supabase use the DIRECT or SESSION pooler string (port 5432), not the transaction pooler (6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agents_dev

PUBLIC_BASE_URL=https://your-platform-domain.example
PORT=8080

# openssl rand -base64 32   (each one different; keep DATA_ENCRYPTION_KEY safe: losing it means reconnecting every business)
DATA_ENCRYPTION_KEY=
SIGNING_SECRET=

# Claude API (Console, under the business entity). AGENT_MODE=mock runs without model calls.
ANTHROPIC_API_KEY=
AGENT_MODE=live

# Meta: WhatsApp Cloud API
WA_APP_SECRET=                      # App settings > Basic > App secret (verifies webhook signatures)
WA_VERIFY_TOKEN=                    # any random string; enter the same in the webhook settings
PLATFORM_WA_PHONE_NUMBER_ID=        # the platform's own number, used to send approvals to owners
PLATFORM_WA_TOKEN=                  # system user token with whatsapp_business_messaging
APPROVAL_TEMPLATE_NAME=draft_ready_for_approval
APPROVAL_TEMPLATE_LANG=en_GB
GRAPH_API_VERSION=v21.0

# Google Cloud: OAuth client (Web application). Redirect URI: ${PUBLIC_BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
CHECKATRADE_ALLOWED_IPS=            # comma-separated, from Checkatrade's webhook docs
HOLD_HOURS=48                       # how long offered times are held
WORKER_CONCURRENCY=4

# Admin web app (Supabase Auth). Set ONE of the two: SUPABASE_URL for projects with asymmetric signing keys (JWKS),
# or SUPABASE_JWT_SECRET for the legacy shared secret. ADMIN_ORIGIN is the web app's address, allowed to call /api.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
ADMIN_ORIGIN=http://localhost:5173
